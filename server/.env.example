# Server environment variables
# Copy this file to .env and fill in your values

MONGO_URI=your_mongodb_connection_string_here

# Required. At least 32 random characters; the server refuses to start otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5000

# Optional. Extra browser origins allowed by CORS, comma-separated
# (localhost:3000 and the production Vercel URL are always allowed).
# CORS_ORIGINS=https://my-preview.vercel.app
