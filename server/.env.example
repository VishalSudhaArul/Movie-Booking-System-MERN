# Server environment variables
# Copy this file to .env and fill in your values

MONGO_URI=your_mongodb_connection_string_here

# Required. At least 32 random characters; the server refuses to start otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5000

# Optional. Extra browser origins allowed by CORS, comma-separated
# (localhost:3000 and the production Vercel URL are always allowed).
# CORS_ORIGINS=https://my-preview.vercel.app

# ── Admin access (the Admin entry in the navbar: password only) ──────────
# The admin password. Checked only on the server; never put it in the client.
# In production (NODE_ENV=production, or on Render) it must be at least 16
# characters and mix three of: lower-case, upper-case, digits, symbols.
# Common passwords such as 123456 are refused and admin sign-in stays off.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url') + '-A1')"
ADMIN_ACCESS_PASSWORD=

# Optional, LOCAL DEVELOPMENT ONLY: an easy demo password (e.g. your old one).
# Ignored in production. Never set this on Render.
# ADMIN_DEMO_PASSWORD=

# Optional. How long an admin session lasts, in minutes (default 120, 5-720).
# ADMIN_SESSION_TTL_MINUTES=120
# Optional. Wrong passwords from one client before a 15-minute lockout (default 5).
# ADMIN_LOGIN_MAX_FAILURES=5
